      fx:controller="com.gt.gui.controller.StartController"
      alignment="CENTER"
      spacing="20">

    <Label text="JavaTech Solutions LMS"
           style="-fx-font-size: 26px;"/>

    <Label text="Learning Management System"/>

    <Button text="Login"
            prefWidth="200"
