<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gt.gui.controller.BackupController"
      alignment="CENTER"
      spacing="15">

      <Button text="Backup erstellen"
        onAction="#createBackup"/>

<Button text="Backup wiederherstellen"
        onAction="#restoreBackup"/>

    <Button text="Zurück"
            prefWidth="200"
            onAction="#back"/>
</VBox>



