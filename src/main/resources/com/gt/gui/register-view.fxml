<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gt.gui.controller.RegisterController"
      alignment="CENTER"
      spacing="15">

    <Label text="Registrierung"
           style="-fx-font-size: 24px;"/>

    <Label text="Name"/>

    <TextField fx:id="nameField"
               promptText="Name"
               maxWidth="300"/>

    <Label text="E-Mail"/>

    <TextField fx:id="emailField"
               promptText="E-Mail"
               maxWidth="300"/>

    <Button text="Registrieren"
            prefWidth="200"
            onAction="#register"/>

    <Button text="Zurück"
            prefWidth="200"
            onAction="#back"/>

</VBox>