<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gt.gui.controller.CourseDetailController"
      spacing="12"
      alignment="CENTER">

    <Label fx:id="titleLabel"
           style="-fx-font-size: 26px;"/>

    <Label text="Beschreibung:"/>

    <Label fx:id="descriptionLabel"
           wrapText="true"
           maxWidth="500"/>

    <Label fx:id="categoryLabel"/>

    <Label fx:id="difficultyLabel"/>

    <Label fx:id="priceLabel"/>

    <Label fx:id="instructorLabel"/>

    <VBox spacing="12">

    <Label text="Kursfortschritt"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="10">
        <Label fx:id="progressLabel"
               text="0% abgeschlossen" />

        <Label fx:id="lessonCountLabel"
               text="0 / 0 lektionen" />
    </HBox>

    <ProgressBar fx:id="progressBar"
                 progress="0"
                 prefWidth="400"
                 maxWidth="Infinity" />

    <Label text="Lektionen"
           style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <VBox fx:id="lessonContainer"
          spacing="10" />

</VBox>



    <Button text="Zurück"
            prefWidth="200"
            onAction="#back"/>

   <HBox alignment="CENTER"
      spacing="10">

    <Button fx:id="enrollButton"
            text="Für Kurs anmelden"
            onAction="#enroll"/>

    <Button fx:id="unenrollButton"
            text="Vom Kurs abmelden"
            onAction="#unenroll"/>

</HBox>

<Separator />

<Label text="Bewertung"
       style="-fx-font-size: 18px; -fx-font-weight: bold;" />

<HBox spacing="10">
    <Label text="Durchschnitt:" />
    <Label fx:id="averageRatingLabel"
           text="Noch keine Bewertungen" />
</HBox>

<HBox spacing="10">
    <Label text="Deine Bewertung:" />

    <ComboBox fx:id="ratingComboBox"
              prefWidth="100" />

<Button fx:id="rateButton"
        text="Bewerten"
        onAction="#rateCourse" />
</HBox>

<Label fx:id="ratingMessageLabel" />

</VBox>