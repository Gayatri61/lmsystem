<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gt.gui.controller.CourseOverviewController"
      alignment="CENTER"
      spacing="15">

    <Label text="Verfügbare Kurse"
           style="-fx-font-size: 24px;"/>

    <!-- Suche -->
    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="searchField"
                   promptText="Kurs suchen..."
                   prefWidth="300"/>

        <Button text="Suchen"
                onAction="#searchCourses"/>
    </HBox>

    <!-- Filter -->
    <HBox alignment="CENTER" spacing="10">

        <ComboBox fx:id="categoryComboBox"
                  promptText="Kategorie"/>

        <ComboBox fx:id="difficultyComboBox"
                  promptText="Schwierigkeit"/>

        <Button text="Filtern"
                onAction="#filterCourses"/>

        <Button text="Zurücksetzen"
                onAction="#resetCourses"/>

    </HBox>

    <ListView fx:id="courseListView"
              prefWidth="600"
              prefHeight="350"/>

    <Button text="Kursdetails"
            prefWidth="200"
            onAction="#showCourseDetails"/>

</VBox>